# 운영 서버 /opt/aram/.env 에 들어갈 값이에요. 이 파일은 이름만 보여주는 예시라 값을 넣지 않아요.
# 실제 .env 는 서버에만 있고 git에 올라가지 않아요.

# 사이트 주소 (https:// 없이). 예: aram-gg.com
DOMAIN=

# DB 비밀번호. 영문과 숫자로 된 긴 무작위 값을 써요.
POSTGRES_PASSWORD=

# 디스코드 개발자 포털의 OAuth2 값 (로컬 backend/.env 와 같은 앱)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 관리자 디스코드 사용자 ID (여러 명이면 쉼표로 구분)
APP_ADMIN_DISCORD_IDS=

# IMAGE_TAG 는 deploy.sh 가 관리해요. 직접 넣지 않아요.
