# 이 파일을 복사해서 backend/.env 로 만들고 값을 채워요. backend/.env 는 git에 올라가지 않아요.

# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 만든 앱의 OAuth2 값
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 관리자 디스코드 사용자 ID (여러 명이면 쉼표로 구분)
APP_ADMIN_DISCORD_IDS=

# 로컬 확인용 로그인. 내 컴퓨터에서만 true로 쓰고, 운영 서버에서는 false로 둬요.
APP_DEV_LOGIN_ENABLED=false
